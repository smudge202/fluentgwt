<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Clears the solution-wide TargetFrameworks; GetTargetPath, which packing the analysers needs, exists only on a single-target project. -->
		<TargetFrameworks></TargetFrameworks>
		<TargetFramework>netstandard2.0</TargetFramework>
		<AssemblyName>FluentGwt.Analysers.CodeFixes</AssemblyName>
		<RootNamespace>FluentGwt.Analysers.CodeFixes</RootNamespace>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<IsRoslynComponent>true</IsRoslynComponent>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FluentGwt.Analysers\FluentGwt.Analysers.csproj" />
	</ItemGroup>

</Project>
