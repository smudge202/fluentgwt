<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>FluentGwt.Bogus</AssemblyName>
		<RootNamespace>FluentGwt</RootNamespace>
		<Description>FluentGwt with Bogus: fixture.Fake and fixture.Random, seeded from the fixture so a failing test can be replayed.</Description>
		<PackageTags>$(PackageTags);bogus;faker;test-data</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Bogus" Version="35.6.5" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\FluentGwt\FluentGwt.csproj" PrivateAssets="none" />
	</ItemGroup>

</Project>
