<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>FluentGwt</AssemblyName>
		<RootNamespace>FluentGwt</RootNamespace>
		<Description>Given/When/Then for .NET tests: chains that read as one expression, a ServiceFixture whose container refuses late registrations, overrides, configuration, seeded test data, time control and teardown.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AwesomeAssertions" Version="9.6.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.10.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
	</ItemGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\FluentGwt.Analysers\FluentGwt.Analysers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
		<ProjectReference Include="..\FluentGwt.Analysers.CodeFixes\FluentGwt.Analysers.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAnalysers</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<Target Name="PackAnalysers">
		<MSBuild Projects="@(ProjectReference)" Targets="GetTargetPath" Condition="'%(ProjectReference.ReferenceOutputAssembly)' == 'false'">
			<Output TaskParameter="TargetOutputs" ItemName="_PackedAnalyser" />
		</MSBuild>
		<ItemGroup>
			<TfmSpecificPackageFile Include="@(_PackedAnalyser)" PackagePath="analyzers/dotnet/cs" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<Compile Update="Given.Base.cs">
			<DependentUpon>Given.cs</DependentUpon>
		</Compile>
		<Compile Update="Given.TargetedExtensions.cs">
			<DependentUpon>Given.cs</DependentUpon>
		</Compile>
		<Compile Update="Given.Targeted.cs">
			<DependentUpon>Given.cs</DependentUpon>
		</Compile>
		<Compile Update="Given.UntargetedExtensions.cs">
			<DependentUpon>Given.cs</DependentUpon>
		</Compile>
		<Compile Update="Given.Untargeted.cs">
			<DependentUpon>Given.cs</DependentUpon>
		</Compile>
		<Compile Update="StateHolder.Extensions.cs">
			<DependentUpon>StateHolder.cs</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>
