<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<RootNamespace>FluentGwt.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AwesomeAssertions" Version="9.6.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
		<PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
		<PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
		<PackageReference Include="xunit.v3" Version="4.0.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\FluentGwt\FluentGwt.csproj" />
		<ProjectReference Include="..\..\src\FluentGwt.Analysers\FluentGwt.Analysers.csproj" />
		<ProjectReference Include="..\..\src\FluentGwt.Analysers.CodeFixes\FluentGwt.Analysers.CodeFixes.csproj" />
		<ProjectReference Include="..\..\src\FluentGwt.AspNetCore\FluentGwt.AspNetCore.csproj" />
		<ProjectReference Include="..\..\src\FluentGwt.Bogus\FluentGwt.Bogus.csproj" />
		<ProjectReference Include="..\..\src\FluentGwt.Http\FluentGwt.Http.csproj" />
		<ProjectReference Include="..\..\src\FluentGwt.Moq\FluentGwt.Moq.csproj" />
		<ProjectReference Include="..\..\src\FluentGwt.Xunit\FluentGwt.Xunit.csproj" />
		<ProjectReference Include="..\FluentGwt.Tests.Integrated\FluentGwt.Tests.Integrated.csproj" />
		<ProjectReference Include="..\FluentGwt.Tests.Web\FluentGwt.Tests.Web.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="**/*.*.cs" DependentUpon="$([System.String]::Copy('%(Filename)').Split('.')[0]).cs" />
	</ItemGroup>

	<ItemGroup>
		<Analyzer Include="..\..\src\FluentGwt.Analysers\bin\$(Configuration)\netstandard2.0\FluentGwt.Analysers.dll" />
	</ItemGroup>

	<Import Project="..\..\src\FluentGwt.Xunit\buildTransitive\FluentGwt.Xunit.targets" />

</Project>
